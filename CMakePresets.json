{
  "version": 3,
  "configurePresets":[
    {
      "name": "dev",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/${presetName}",
      "installDir": "${sourceDir}/out/${presetName}/install",
      "cacheVariables": {
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SFML_BUILD_EXAMPLES": "ON",
        "SFML_BUILD_TEST_SUITE": "ON",
        "SFML_ENABLE_STDLIB_ASSERTIONS": "ON",
        "SFML_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "mac",
      "inherits": "dev",
      "generator": "Xcode",
      "cacheVariables": {
        "SFML_GRAPHICS_BACKEND": "Metal"
      }
    },
    {
      "name": "ios",
      "inherits": "dev",
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "SFML_GRAPHICS_BACKEND": "Metal"
      }
    },
    {
      "name": "windows",
      "inherits": "dev",
      "cacheVariables": {
        "SFML_GRAPHICS_BACKEND": "DX12"
      }
    }
  ]
}
